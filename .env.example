# 复制为 .env 后按环境修改。docker compose 会自动读取项目根目录的 .env。
#   copy .env.example .env

MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=inventory_system
MYSQL_USER=ims
MYSQL_PASSWORD=ims123456
MYSQL_PORT=3307

APP_PORT=8080

# 生产必须替换为足够长的随机串（至少 32 字符 / 256 bit）
IMS_JWT_SECRET=please-change-this-to-a-long-random-secret-at-least-32-chars
IMS_JWT_EXPIRATION_MS=86400000

# 生产保持 validate；仅当未执行 docs/schema.sql 初始化时才改为 update
JPA_DDL_AUTO=validate
